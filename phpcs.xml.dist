<?xml version="1.0"?>
<ruleset
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        name="PHP_CodeSniffer"
        xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd"
>
    <description>The Moex Core coding standard.</description>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="bootstrap" value="vendor/autoload.php"/>

    <file>src</file>
    <file>tests</file>

    <config name="installed_paths" value="vendor/prikotov/coding-standard"/>

    <rule ref="PSR12"/>
    <!--
        Direct sniff file reference: the external package ruleset does not
        declare a namespace, so PrikotovCodingStandard.Sniffs.* refs do not resolve.
    -->
    <rule ref="./vendor/prikotov/coding-standard/src/Sniffs/Structure/DtoStructureSniff.php"/>

    <exclude-pattern>/vendor</exclude-pattern>
    <exclude-pattern>/var</exclude-pattern>
</ruleset>
